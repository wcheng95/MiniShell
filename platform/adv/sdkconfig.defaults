CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The resident MiniShell runtime/shell executes on ESP-IDF's main task. Keep
# enough stack for shell/backend call depth; foreground applications run on a
# separate ADV-managed application task and do not borrow this stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Fail clearly on future task-stack exhaustion instead of allowing silent
# memory corruption to turn into an unrelated exception.
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# Both ADV storage volumes use FATFS: /flash is internal SPI flash through the
# ESP-IDF wear-levelling layer and /sd is removable FATFS over SDSPI. MiniShell's
# Filesystem contract allows names up to MINI_FS_NAME_MAX (255), so enable long
# filenames explicitly. Heap-backed LFN avoids consuming resident/app task
# stack, and UTF-8 keeps VFS filename representation compatible with the
# byte-string MiniShell API.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
